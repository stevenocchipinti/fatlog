{
  "name": "fatlog",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --port 3000 --host",
    "start": "vite --port 3000 --host",
    "build": "vite build && tsc",
    "build:beta": "vite build --mode beta && tsc",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "prettier",
    "check": "prettier --write . && oxlint --fix",
    "emulators": "firebase emulators:start --only auth,database,hosting",
    "ci": "npm run lint && npm run test",
    "deploy": "firebase deploy --only hosting:prod",
    "deploy:beta": "npm run build:beta && firebase deploy --only hosting:beta"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.6",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.11",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-router": "^1.114.3",
    "@tanstack/react-router-devtools": "^1.114.3",
    "@tanstack/router-plugin": "^1.114.3",
    "chartjs": "^0.3.24",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^13.2.0",
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.69.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.6",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "web-vitals": "^6.2.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
